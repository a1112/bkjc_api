
/*DeamonService:后台监控服务
cmd 类型
 1、打开所有被监控程序
{"type":"cmd","oper":"openAll"}
2、关闭所有被监控的程序
{"type":"cmd","oper":"closeAll"}
3、打开指定的程序， 以NCDSysLogService日志服务为例
{"type":"cmd","oper":"open","name":"NCDSysLogService"}
4、关闭指定的程序，以NCDSysLogService日志服务为例
{"type":"cmd","oper":"close","name":"NCDSysLogService"}
query类型:
1、询问所有被监控程序的工作状态
{"type": "query", "status": "all"}
2、询问指定监控程序的工作状态,以NCDSysLogService日志服务为例
{"type": "query","status": "NCDSysLogService"}
*/

/*SysConfigService:系统配置服务
cmd类型：


query类型:
1、询问所有缺陷类别
{"type":"query","name":"defectClass","oper":"all"}
2、询问缺陷类别数量
{"type":"query","name":"defectClass","oper":"num"}
 3、询问指定类别名称的缺陷类别信息
{"type":"query","name":"defectClass","oper":"byName","className":"孔洞"}
4、询问指定类别号的缺陷类别信息
{"type":"query","name":"defectClass","oper":"byClass","class":7}

  */
/*SysLogService:系统日志服务
 cmd类型:
  1、添加日志信息到日志数据库，grade 为0添加到正常消息表中，非0添加到错误消息表中
{"type":"cmd","oper":"addLog","from":"testService","info":"这是一个错误消息", "grade":-1}
  */

/*RecordService:检测记录服务
 cmd类型:
  1、添加检测记录到记录数据库
{"type":"cmd","oper":"addRecord","seqNo":1002,"subSeqNo":3,"id":"testID","steelType":"Q235","length":23521,"thick":25,"DefectNum":340,"width":2100,"grade":2,"surface":0,"warn":0,"detectTime":"2020-9-30 10:48:32"}
2、更新检测记录信息，可以不用把所有字段数据进行提供,注意必须提供SeqNo参数
 {"type":"cmd","oper":"updateRecord","seqNo":1002,"subSeqNo":3,"id":"testID","steelType":"Q235","length":23521,"thick":25,"DefectNum":340,"width":2100,"grade":2,"surface":0,"warn":0,"detectTime":"2020-9-30 10:48:32"}
*/

/*NCDDefectService:检测缺陷服务
  1、添加缺陷记录
{"type":"cmd","oper":"addDefect","cam":1,"seq":1002,"items":[{"ii":11,"cs":3, "li":100,"ri":2000, "ti":300,"bi":1200,"lo":300, "ro":1000,"to":500, "bo":900, "gd":2, "ar":1000},{"ii":12,"cs":1, "li":100,"ri":2000, "ti":300,"bi":1200,"lo":300, "ro":1000,"to":500, "bo":900, "gd":2, "ar":1000}]}


  */
